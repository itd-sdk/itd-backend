# Loaded automatically by `bun test` (NODE_ENV=test). The database name must end with "_test":
# the suite truncates every table before each test file.
DATABASE_URL=postgres://itd:itd@localhost:5432/itd_test
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=itdtest:
JWT_SECRET=test-secret-not-for-production
EMAIL_VERIFICATION=true
DEV_EXPOSE_OTP=true
RATE_LIMIT_MULTIPLIER=1000
UPLOAD_DIR=./.test-uploads
PUBLIC_URL=http://localhost
QR_REQUIRE_MOBILE_APPROVER=true
EVENT_ENABLED=true
DOMINANT_EMOJI_MIN_LIKES=2
LOG_LEVEL=error
TRUST_PROXY=true
