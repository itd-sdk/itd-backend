{
  "name": "itd-backend",
  "version": "0.1.0",
  "description": "Backend clone of the ITD (итд.com) social network, API-compatible with itd-sdk",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "test:sdk": "tests/sdk/run.sh"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.52",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
