# ---- server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# public base url, used for upload urls, QR payloads and payment links
PUBLIC_URL=http://localhost:3000
# comma separated list of allowed browser origins (empty: reflect any origin, development only)
CORS_ORIGINS=
# trust X-Forwarded-For / CF-Connecting-IP / CF-IPCountry (enable behind a reverse proxy)
TRUST_PROXY=false
LOG_LEVEL=info
# run migrations when the server starts
MIGRATE_ON_START=false
JOBS_ENABLED=true

# ---- storage
DATABASE_URL=postgres://itd:itd@localhost:5432/itd
DATABASE_POOL_SIZE=20
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=itd:

# ---- auth
# required in production: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
BCRYPT_ROUNDS=10
# one-time codes come from the Telegram bot (deploy/telegram-bot): on sign-up and, with LOGIN_CODE, on every sign-in
TELEGRAM_VERIFICATION=true
LOGIN_CODE=true
# bot username, shown in error messages
TELEGRAM_BOT=openitd_bot
# development only: return one-time codes in API responses and the log
DEV_EXPOSE_OTP=true
OTP_TTL=900
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
QR_TTL=90
QR_REQUIRE_MOBILE_APPROVER=true
ACCOUNT_RESTORE_DAYS=30

# ---- uploads: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=200
MAX_AUDIO_SIZE_MB=50

# ---- limits & content
RATE_LIMIT_ENABLED=true
# scales every limit (2 = twice as many requests)
RATE_LIMIT_MULTIPLIER=1
POST_MAX_LENGTH=5000
COMMENT_MAX_LENGTH=1000
BIO_MAX_LENGTH=500
MAX_ATTACHMENTS=10
POST_EDIT_WINDOW_HOURS=48
POST_RESTORE_WINDOW_DAYS=7
BANNED_WORDS=
DOMINANT_EMOJI_MIN_LIKES=3
POPULAR_WINDOW_DAYS=7
POPULAR_REBUILD_SECONDS=60

# ---- seasonal event
# one switch: the menu item, the portal and the event frame (/event/alice-ai -> /public/events/aliceai)
EVENT_ENABLED=false
EVENT_ID=aliceai
# ends at the start of next month when empty
EVENT_ENDS_AT=
EVENT_DAILY_REWARD=20
# portal defaults follow EVENT_ENABLED; override only for a custom link
PORTAL_ACTIVE=
PORTAL_TITLE=Портал
PORTAL_URL=/public/events/aliceai/

# ---- seed: creates an admin account when both are set (Telegram username, the admin signs in with a bot code)
ADMIN_TELEGRAM=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
